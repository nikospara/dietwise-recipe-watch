    "@ionic/react": "^8.8.2",
    "@ionic/react-router": "^8.8.2",
    "@types/react-router": "^5.1.20",
    "@types/react-router-dom": "^5.3.3",
    "capacitor-secure-storage-plugin": "^0.13.0",
    "ionic-appauth": "^2.1.0",
    "ionicons": "^8.0.13",
    "jotai": "^2.19.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-i18next": "^16.6.6",
    "react-icons": "^5.6.0",
