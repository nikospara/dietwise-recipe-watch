{
  "name": "recipe-watch",
  "description": "A dietary recommendations application that makes suggestions on online recipes to fit user needs, health, and other nutritional constraints",
  "private": true,
  "version": "0.13.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:mobile-preview": "tsc && VITE_INCLUDE_MOBILE_PREVIEW=true vite build",
    "preview": "vite preview",
    "i18n:csv:export": "node scripts/i18n-csv.mjs export",
    "i18n:csv:import": "node scripts/i18n-csv.mjs import",
    "set-app-version": "node scripts/set-app-version.mjs",
    "assets:android": "npx @capacitor/assets generate --android --assetPath resources --iconBackgroundColor '#ffffff' --splashBackgroundColor '#ffffff' && npx cap sync android",
    "assets:help": "npx @capacitor/assets generate --help",
    "assets:ios": "npx @capacitor/assets generate --ios --assetPath resources --iconBackgroundColor '#ffffff' --splashBackgroundColor '#ffffff' && npx cap sync ios",
    "test": "vitest",
    "lint": "eslint"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "8.4.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/browser": "8.0.4",
    "@capacitor/core": "8.4.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.4.2",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/status-bar": "8.0.3",
    "@ionic/react": "8.8.15",
    "@ionic/react-router": "8.8.15",
    "@types/react-router": "^5.1.20",
    "@types/react-router-dom": "^5.3.3",
    "capacitor-secure-storage-plugin": "^0.13.0",
    "ionic-appauth": "^2.1.0",
    "ionicons": "^8.0.13",
    "jotai": "2.20.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.11",
    "react-icons": "5.7.0",
    "react-router": "^5.3.4",
    "react-router-dom": "^5.3.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "8.4.2",
    "@nabla/vite-plugin-eslint": "^3.0.1",
    "@testing-library/dom": ">=7.21.4",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "baseline-browser-mapping": "2.11.4",
    "cypress": "15.19.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "17.8.0",
    "jsdom": "^29.1.1",
    "prettier": "3.9.6",
    "terser": "5.49.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
